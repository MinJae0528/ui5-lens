{
  "name": "ui5-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:api": "node scripts/fetch-api.mjs",
    "fetch:topics": "node scripts/fetch-topics.mjs",
    "build:data": "node scripts/build-data.mjs",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && npm run typecheck && npm test && vite build",
    "preview": "vite preview",
    "test:e2e": "node scripts/e2e.mjs",
    "ko:stamp": "node scripts/ko-stamp.mjs",
    "verify:examples": "node scripts/verify-examples.mjs",
    "discover:versions": "node scripts/discover-versions.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "node --test \"test/*.test.ts\"",
    "eval:recommend": "node scripts/eval-recommend.mjs",
    "app": "vite build && vite preview --open --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
