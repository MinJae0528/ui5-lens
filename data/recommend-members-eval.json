    { "q": "목록에 항목 추가하기", "expect": ["List#addItem", "ListBase#addItem", "Table#addItem"] },
    { "q": "컨테이너에 자식 컨트롤 넣기", "expect": ["addContent", "addItem"] },
    { "q": "모델을 화면에 연결", "expect": ["setModel"] },
    { "q": "컨트롤 숨기기", "expect": ["setVisible"] },
    { "q": "버튼 비활성화", "expect": ["Button#enabled", "Button#setEnabled", "setEnabled"] },
    { "q": "대화상자 열기", "expect": ["Dialog#open"] },
    { "q": "대화상자 닫기", "expect": ["Dialog#close"] },
    { "q": "선택된 항목 가져오기", "expect": ["getSelectedItem", "getSelectedItems", "getSelectedKey"] },
    { "q": "삭제할 때 확인창 띄우기", "expect": ["MessageBox#confirm", "MessageBox#show"] },
    { "q": "잠깐 알림 메시지 보여주기", "expect": ["MessageToast#show"] },
    { "q": "데이터 바인딩 경로 지정", "expect": ["bindProperty", "bindAggregation", "bindElement", "bindContext"] },
    { "q": "다른 화면으로 이동", "expect": ["navTo", "to", "NavContainer#to"] },
    { "q": "필터 적용", "expect": ["filter", "ListBinding#filter"] },
    { "q": "정렬하기", "expect": ["sort", "ListBinding#sort"] },
    { "q": "컨트롤을 화면 영역에 배치", "expect": ["placeAt"] },
    { "q": "텍스트 설정", "expect": ["setText", "Text#text", "Button#text"] },
    { "q": "포커스 맞추기", "expect": ["focus", "applyFocusInfo"] },
    { "q": "아이디로 컨트롤 찾기", "expect": ["byId"] },
    { "q": "스타일 클래스 추가", "expect": ["addStyleClass"] },
    { "q": "파일 업로드 시작", "expect": ["FileUploader#upload"] },
    { "q": "탭 선택 바꾸기", "expect": ["IconTabBar#setSelectedKey", "IconTabBar#selectedKey", "IconTabBar#select", "setSelectedKey"] },
    { "q": "검색어를 입력했을 때", "expect": ["SearchField#search", "SearchField#liveChange", "SearchField#attachSearch"] },
    { "q": "체크박스 선택 상태 읽기", "expect": ["CheckBox#selected", "CheckBox#getSelected", "getSelected"] },
    { "q": "화면을 로딩 중 상태로", "expect": ["setBusy", "BusyIndicator#show", "BusyDialog#open", "busy"] },
    { "q": "다국어 문구 가져오기", "expect": ["getText", "ResourceBundle#getText", "getResourceBundle"] },
    { "q": "날짜 값 읽기", "expect": ["DatePicker#getDateValue", "DatePicker#dateValue", "getDateValue"] },
    { "q": "목록을 새로고침", "expect": ["refresh", "updateItems", "ListBinding#refresh"] },
    { "q": "이벤트를 발생시키기", "expect": ["fireEvent", "fireEvent", "fire"] }
  ]
